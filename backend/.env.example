PORT=3000

# JSON complet de la clé de compte de service Firebase (Console Firebase >
# Paramètres du projet > Comptes de service > Générer une nouvelle clé privée),
# collé sur une seule ligne. Ne jamais committer la vraie valeur.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", "...": "..."}

# Secret long et aléatoire, généré une fois (ex. `openssl rand -hex 32`), utilisé
# pour tester l'API via Postman sans passer par un vrai login Firebase.
STATIC_API_TOKEN=

# Origines autorisées en CORS, séparées par des virgules (ex. domaine Firebase
# Hosting + localhost de dev).
CORS_ALLOWED_ORIGIN=http://localhost:5000,http://localhost:5173
