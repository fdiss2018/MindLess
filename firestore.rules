rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Un utilisateur est membre du foyer si son uid figure dans foyers/{foyerId}.membres
    function estMembreDuFoyer(foyerId) {
      return request.auth != null &&
        request.auth.uid in
          get(/databases/$(database)/documents/foyers/$(foyerId)).data.membres;
    }

    // Traduction de backend/src/coeur/domain/AccesModules.js (seule source de vérité des droits) :
    // membre du foyer, et administrateur (créateur), module listé dans modulesParMembre[uid], ou
    // module à l'essai pas encore expiré (demandesModules[uid][module], expiration en ms).
    function aAccesModule(foyerId, module) {
      let foyer = get(/databases/$(database)/documents/foyers/$(foyerId)).data;
      let demande = foyer.get('demandesModules', {}).get(request.auth.uid, {}).get(module, {});
      return request.auth != null &&
        request.auth.uid in foyer.membres &&
        (request.auth.uid == foyer.creePar ||
          module in foyer.get('modulesParMembre', {}).get(request.auth.uid, []) ||
          (demande.get('statut', '') == 'en_attente' &&
            request.time.toMillis() < demande.get('expiration', 0)));
    }

    // Toutes les écritures passent désormais par le backend (SDK Admin, qui
    // contourne ces règles) — le client n'a plus qu'un accès en lecture, et
    // uniquement là où le temps réel (onSnapshot) est encore utilisé côté
    // front : foyer (cœur), planning repas (module menus), liste de courses
    // (module courses). Voir CLAUDE.md pour le détail.

    match /utilisateurs/{uid} {
      allow read, write: if false;
    }

    match /foyers/{foyerId} {
      allow read: if estMembreDuFoyer(foyerId);
      allow write: if false;

      match /planningRepas/{document=**} {
        allow read: if aAccesModule(foyerId, 'menus');
        allow write: if false;
      }

      match /listeCourses/{document=**} {
        allow read: if aAccesModule(foyerId, 'courses');
        allow write: if false;
      }

      match /vehicules/{document=**} {
        allow read, write: if false;
      }

      match /recettes/{document=**} {
        allow read, write: if false;
      }

      match /profilsNutritionnels/{document=**} {
        allow read, write: if false;
      }

      match /articles/{document=**} {
        allow read, write: if false;
      }

      match /veilleConfig/{document=**} {
        allow read, write: if false;
      }

      match /memoires/{document=**} {
        allow read, write: if false;
      }
    }
  }
}
